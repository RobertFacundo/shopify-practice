{{ 'featured.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured.js' | asset_url}}" defer></script>

<section class="featured full-width">
  <div class="featured__content">
    <span class="featured__eyebrow"> Featured pieces </span>

    <h1 class="featured__title">
      {{ section.settings.title }}
    </h1>

    <div class="featured__navigation">
      <button class="featured__arrow featured__arrow--prev" type="button">←</button>

      <button class="featured__arrow featured__arrow--next" type="button">→</button>
    </div>
  </div>

  <div class="featured__image">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1200 | image_tag }}
    {% endif %}
  </div>

  <div class="featured__products">
    {% for product in section.settings.collection.products %}
      {% assign remainder = forloop.index0 | modulo: 2 %}

      {% if remainder == 0 %}
        <div class="featured__products-group">
      {% endif %}

      {% render 'featured-product-card', product: product %}

      {% if remainder == 1 or forloop.last %}
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Products"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center image"
    }
  ]
}
{% endschema %}
