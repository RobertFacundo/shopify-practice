{{ 'header.css' | asset_url | stylesheet_tag }}
{{ 'header-mobile.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header.js'| asset_url }}" defer></script>

<style>
  {{ section.settings.title_font | font_face }}

  .header__title, .header-mobile__title a {
    font-family: {{ section.settings.title_font.family }};
    font-style: {{ section.settings.title_font.style }};
    font-weight: {{ section.settings.title_font.weight }};
  }
</style>

{% render 'header-desktop',
  menu: section.settings.menu,
  customer_account_menu: section.settings.customer_account_menu
%}

{% render 'header-mobile',
  menu: section.settings.menu,
  customer_account_menu: section.settings.customer_account_menu
%}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "font_picker",
      "id": "title_font",
      "label": "Title font",
      "default": "assistant_n4"
    }
  ]
}
{% endschema %}
