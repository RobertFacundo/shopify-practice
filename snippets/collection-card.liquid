{{ 'collection-card.css' | asset_url | stylesheet_tag }}

<a class="collection-card" href="{{ routes.all_products_collection_url }}">

  <div class="collection-card__background"></div>

  <div class="collection-card__media">
    {% if image %}
      {{ image | image_url: width: 900 | image_tag }}
    {% endif %}
  </div>

  <div class="collection-card__content">
    <h3 class="collection-card__title">
      {{ collection.title }}
    </h3>
  </div>
</a>
