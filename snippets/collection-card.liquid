{{ 'collection-card.css' | asset_url | stylesheet_tag }}

<a class="collection-card" href="{{ collection.url }}">
  <div class="collection-card__media">
    {% if collection.image %}
      {{ collection.image | image_url: width: 900 | image_tag }}
    {% elsif collection.products.first.featured_image %}
      {{ collection.products.first.featured_image | image_url: width: 900 | image_tag }}
    {% endif %}
  </div>

  <div class="collection-card__content">
    <h3 class="collection-card__title">{{ collection.title }}</h3>
  </div>
</a>
