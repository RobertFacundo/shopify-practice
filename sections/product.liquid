{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{{ 'product-detail.css' | asset_url | stylesheet_tag }}
{{ 'product-gallery.css' | asset_url | stylesheet_tag }}
{{ 'product-info.css' | asset_url | stylesheet_tag }}
{{ 'product-tabs.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-detail.js' | asset_url }}" defer></script>

<section class="product-detail full-width">
  <div class="product-detail-breadcrumb">
    {% render 'breadcrumb' %}
  </div>
  <div class="product-detail-info">
    {% render 'product-gallery' %}
    {% render 'product-info' %}
  </div>
  {% render 'product-tabs', product: product, tabs_image:section.settings.tabs_image %}
</section>

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "image_picker",
      "id": "tabs_image",
      "label": "Product tabs image"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
