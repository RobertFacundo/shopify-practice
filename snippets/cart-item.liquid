<div
  class="cart-item"
  data-line="{{ item.index | plus: 1 }}"
  data-key="{{ item.key }}"
>
  <div class="cart-item__image">
    {% render 'image', image: item.image, url: item.url %}
  </div>

  <div class="cart-item__info">
    <p class="cart-item__title">{{ item.product.title }}</p>

    <span class="cart-item__price">
      {{ item.final_price | money }}
    </span>

    <div class="cart-item__quantity">
      <button type="button" class="quantity-minus">−</button>
      <input type="text" name="updates[]" value="{{ item.quantity }}">
      <button type="button" class="quantity-plus">+</button>
    </div>
  </div>

  <div class="cart-item__actions">
    <span class="cart-item__total">
      {{ item.final_line_price | money }}
    </span>

    {% assign line = item.index | plus: 1 %}

    {{ 'cart.remove' | t | link_to: item.url_to_remove, class: 'cart-item__remove', data-line: line }}
  </div>
</div>
