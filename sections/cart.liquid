{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

{{ 'cart.css' |asset_url | stylesheet_tag }}
{{ 'cart-item.css' |asset_url | stylesheet_tag }}
{{ 'cart-summary.css' |asset_url | stylesheet_tag }}

<div class="cart-section full-width">
  <div class="cart-section-products">
    <div class="cart-header">
      <h1>Your cart</h1>
      <a href="{{ routes.all_products_collection_url }}">Continue shopping </a>
    </div>

    <form action="{{ routes.cart_url }}" method="post">
      <div class="cart-items">
        {% for item in cart.items %}
          {% render 'cart-item', item: item %}
        {% endfor %}
      </div>
    </form>
  </div>
  {% render 'cart-summary', blocks: section.blocks %}
</div>

{% schema %}
{
  "name": "t:general.cart",
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Benefit text"
        }
      ]
    }
  ],
  "settings": []
}
{% endschema %}
